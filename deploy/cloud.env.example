# Secrets belong in Render, never in Vercel VITE_* variables.
APP_ENV=cloud
NODE_ENV=production
PORT=10000
FASTAPI_URL=http://127.0.0.1:8000
APP_PUBLIC_URL=https://YOUR-PROJECT.vercel.app
CORS_ORIGIN=https://YOUR-PROJECT.vercel.app
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_CA_CERT=PASTE_MULTILINE_PEM_IN_RENDER
JWT_SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
LOG_FORMAT=json
EXCEL_EXPORT_MODE=sequential
EXCEL_EXPORT_MAX_ROWS=2000
EXCEL_EXPORT_MAX_CONCURRENT=1
EXCEL_PROXY_TIMEOUT_MS=90000
