{"kind":"textbox","id":"sh/b6d4f2lc","slideIndex":9,"position":{"left":688.89,"top":279.77,"width":523.56,"height":110.07},"name":"Content Placeholder 10","text":"Concorrência\nUm diretório por exportação e um fragmento por bloco. Só o processo principal monta XLSX e ZIP.","geometry":"rect","style":{"fontSize":25,"typeface":"Helvetica Neue","color":"#000000","bold":true,"alignment":"left"}}
