{"kind":"textbox","id":"sh/0f2lgnmp","slideIndex":9,"position":{"left":688.89,"top":489.77,"width":523.56,"height":110.07},"name":"Content Placeholder 10","text":"Ganho limitado\nLeitura, preparação e montagem seguem seriais. Volumes pequenos podem perder tempo ao iniciar processos.","geometry":"rect","style":{"fontSize":25,"typeface":"Helvetica Neue","color":"#000000","bold":true,"alignment":"left"}}
