{"kind":"textbox","id":"sh/wvupgz6t","slideIndex":9,"position":{"left":74.15,"top":279.77,"width":523.56,"height":110.07},"name":"Content Placeholder 10","text":"Deadlocks\nNenhum observado. Workers usam arquivos distintos e não compartilham banco ou workbook. Falhas e I/O ainda exigem atenção.","geometry":"rect","style":{"fontSize":25,"typeface":"Helvetica Neue","color":"#000000","bold":true,"alignment":"left"}}
